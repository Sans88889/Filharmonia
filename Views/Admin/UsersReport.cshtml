@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

<div class="container mt-5">
    <h2>Raport użytkowników</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nazwa użytkownika</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>

