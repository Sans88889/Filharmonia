@page
@model Filharmonia.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-center">
                    <h3>Zaloguj się</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <div class="form-group mb-3">
                            <label asp-for="Input.Email" class="form-label">Adres e-mail</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="Wprowadź swój adres e-mail" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.Password" class="form-label">Hasło</label>
                            <input asp-for="Input.Password" class="form-control" type="password" placeholder="Wprowadź swoje hasło" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>

      
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <span class="text-danger">@Model.ErrorMessage</span>
                            }
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.RememberMe" class="form-check-input" id="RememberMe" />
                            <label asp-for="Input.RememberMe" class="form-check-label">Zapamiętaj mnie</label>
                        </div>

                        <div class="d-flex justify-content-center mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-sign-in"></i> Zaloguj się
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <a asp-page="./ForgotPassword" class="btn btn-link">Zapomniałeś hasła?</a>
                        </div>

                        <div class="text-center mt-1">
                            <a asp-page="./Register" class="btn btn-link">Nie masz konta? Zarejestruj się</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
